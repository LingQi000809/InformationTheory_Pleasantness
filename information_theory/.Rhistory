ppm1,
factor(
extract_seq_from_krn(test_file_pattern, column1),
levels = alphabet1
)
)
res2 = model_seq(
ppm2,
factor(
extract_seq_from_krn(test_file_pattern, column2),
levels = alphabet2
)
)
plot(
res1$information_content,
xlab = "Position",
ylab = "Information content (bits)",
type = "l", col = "blue",
ylim = c(0, 20)
)
points(
res2$information_content,
type = "l", col = "red"
)
