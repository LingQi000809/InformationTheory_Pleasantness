# PPM functions
get_seq_entropy_ic <- function(seq) {
ppm <- new_ppm_simple(alphabet_levels = diatonic_major_scale)
model_seq(
ppm,
factor(
seq,
levels = diatonic_major_scale
)
)
}
plot_seq_entropy_ic <- function(seq) {
res <- get_seq_entropy_ic(seq)
plot(
res$information_content,
xlab = "Position",
ylab = "Information content (bits)",
type = "l", col = "blue",
ylim = c(0, 10)
)
plot(
res$entropy,
xlab = "Position",
ylab = "Entropy (bits)",
type = "l", col = "blue",
ylim = c(0, 5)
)
}
# Alphabet
diatonic_major_scale <- c("I", "ii", "III", "IV", "V", "VI", "vii")
seq_length <- 30
N <- 10000
all_seqs <- vector("list", N)
results <- vector("list", N)
# Run short-term PPM
for (i in 1:N) {
seq <- sample(diatonic_major_scale, seq_length, replace = TRUE)
all_seqs[[i]] <- seq
results[[i]] <- get_seq_entropy_ic(seq)
}
# get results
last_entropies <- sapply(results, function(res) tail(res$entropy, 1))
last_entropies_grouped <- split(seq_along(last_entropies), last_entropies)
dupe_last_entropies <- last_entropies_grouped[sapply(last_entropies_grouped, length) > 1]
results
dupe_last_entropies <- last_entropies_grouped[sapply(last_entropies_grouped, length) > 1]
dupe_last_entropies[[1]]
