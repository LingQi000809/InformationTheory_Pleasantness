train_file_pattern,
test_file_pattern,
all_file_pattern
) {
# build alphabet and ppm
alphabet1 = sort(unique(
extract_seq_from_krn(all_file_pattern, column1)
))
alphabet2 = sort(unique(
extract_seq_from_krn(all_file_pattern, column2)
))
ppm1 <- new_ppm_simple(alphabet_size = length(alphabet1), alphabet_levels = alphabet1)
ppm2 <- new_ppm_simple(alphabet_size = length(alphabet2), alphabet_levels = alphabet2)
# train
model_seq(
ppm1,
factor(
extract_seq_from_krn(train_file_pattern, column1),
levels = alphabet1
)
)
